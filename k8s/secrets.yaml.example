# Kubernetes Secrets Template
# Copy this file to secrets.yaml and fill in the values
# IMPORTANT: Never commit secrets.yaml to git!
# Add secrets.yaml to .gitignore

apiVersion: v1
kind: Secret
metadata:
  name: aicfo-secrets
  namespace: aicfo
type: Opaque
stringData:
  # Database
  postgres-user: "aicfo"
  postgres-password: "CHANGE_ME_SECURE_PASSWORD"
  database-url: "postgresql://aicfo:CHANGE_ME_SECURE_PASSWORD@postgres:5432/aicfo_db"

  # OpenRouter API
  openrouter-api-key: "sk-or-v1-YOUR_KEY_HERE"

  # Security Keys
  secret-key: "GENERATE_A_SECURE_KEY_32_CHARACTERS_MIN"
  encryption-key: "GENERATE_32_BYTE_ENCRYPTION_KEY"

  # MinIO
  minio-access-key: "CHANGE_ME_MINIO_ACCESS"
  minio-secret-key: "CHANGE_ME_MINIO_SECRET"

---
# Generate secure keys with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
